# Copia este archivo como .streamlit/secrets.toml (en local) o pega su contenido en
# Streamlit Cloud > tu app > Settings > Secrets. Todo es opcional y gratuito.

# Opción A: Groq (gratis en https://console.groq.com/keys)
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "llama-3.3-70b-versatile"
LLM_API_KEY = "gsk_..."

# Opción B: Google Gemini (gratis en https://aistudio.google.com/apikey)
# LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
# LLM_MODEL = "gemini-2.0-flash"
# LLM_API_KEY = "..."
